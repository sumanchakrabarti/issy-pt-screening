# Copy to .env for local development. In Azure these become App Service
# application settings (see docs/azure-infrastructure.md).

# SQLite database location (Prisma).
# Local dev:  file:./dev.db
# Azure:      file:/home/data/prod.db
DATABASE_URL="file:./dev.db"

# JWT signing secret. Use a strong random value in production.
JWT_SECRET="change-me"

# Comma-separated list of allowed CORS origins (the web app URL).
# Azure example: https://iptscreening-web-app.azurestaticapps.net
CORS_ORIGIN="http://localhost:5173"

# Directory for uploaded screening videos.
# Local dev defaults to packages/api/uploads.
# Azure: /home/data/uploads
# UPLOAD_DIR="./uploads"
