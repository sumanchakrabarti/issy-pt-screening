datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  firstName    String
  lastName     String
  role         String        @default("clinician") // admin, clinician, coach, parent
  clinicId     String?
  clinic       Clinic?       @relation(fields: [clinicId], references: [id])
  coachClubs   CoachClub[]
  parentAthletes ParentAthlete[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Clinic {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  users     User[]
  clubs     Club[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Club {
  id        String      @id @default(cuid())
  name      String
  clinicId  String
  clinic    Clinic      @relation(fields: [clinicId], references: [id])
  teams     Team[]
  coaches   CoachClub[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Team {
  id                String             @id @default(cuid())
  name              String
  clubId            String
  club              Club               @relation(fields: [clubId], references: [id])
  athletes          Athlete[]
  screeningSessions ScreeningSession[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Athlete {
  id                String             @id @default(cuid())
  firstName         String
  lastName          String
  dateOfBirth       DateTime
  gender            String
  medicalHistory    String?
  teamId            String
  team              Team               @relation(fields: [teamId], references: [id])
  screeningSessions ScreeningSession[]
  parents           ParentAthlete[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model ScreeningSession {
  id                    String                 @id @default(cuid())
  athleteId             String
  athlete               Athlete                @relation(fields: [athleteId], references: [id])
  teamId                String
  team                  Team                   @relation(fields: [teamId], references: [id])
  date                  DateTime               @default(now())
  status                String                 @default("in_progress") // in_progress, needs_review, completed, consultation_requested, archived
  riskScore             Float?
  riskCategory          String?                // low, moderate, high, very_high
  notes                 String?
  scoreRecords          ScoreRecord[]
  exercisePrescriptions ExercisePrescription[]
  videos                Video[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model ScoreRecord {
  id        String           @id @default(cuid())
  sessionId String
  session   ScreeningSession @relation(fields: [sessionId], references: [id])
  type      String           // movement, strength, hop
  name      String           // e.g., "single_leg_squat", "quad_strength"
  valueLeft Float?
  valueRight Float?
  score     Float?
  notes     String?
  createdAt DateTime         @default(now())
}

model ExercisePrescription {
  id          String           @id @default(cuid())
  sessionId   String
  session     ScreeningSession @relation(fields: [sessionId], references: [id])
  // Prescriptions now reference the exercise catalog directly.
  exerciseId  String
  exercise    Exercise         @relation(fields: [exerciseId], references: [id])
  // Per-prescription overrides of the exercise's catalog defaults.
  sets        Int?
  reps        Int?
  duration    String?
  notes       String?
  createdAt   DateTime         @default(now())
}

// ---------------------------------------------------------------------------
// Exercise library / catalog
// A reusable, searchable set of exercises a clinician can browse and prescribe.
// Tagged with muscle and ligament groups (many-to-many) and linked to videos.
// ---------------------------------------------------------------------------

model Exercise {
  id              String                  @id @default(cuid())
  name            String                  @unique
  description     String?
  instructions    String?                 // step-by-step cues for the athlete
  category        String                  // strengthening, balance, plyometric, mobility, stretching, proprioception
  bodyRegion      String                  @default("lower_leg") // lower_leg, ankle, foot, knee, hip, thigh
  difficulty      String                  @default("beginner")  // beginner, intermediate, advanced
  defaultSets     Int?
  defaultReps     Int?
  defaultDuration String?
  equipment       String?                 // e.g., "resistance band", "bodyweight", "box"
  muscleGroups    ExerciseMuscleGroup[]
  ligamentGroups  ExerciseLigamentGroup[]
  videos          ExerciseVideo[]
  prescriptions   ExercisePrescription[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
}

model MuscleGroup {
  id        String                @id @default(cuid())
  name      String                @unique // e.g., "Gastrocnemius", "Soleus", "Tibialis Anterior"
  region    String?               // e.g., lower_leg, thigh, hip
  exercises ExerciseMuscleGroup[]
  createdAt DateTime              @default(now())
}

model LigamentGroup {
  id        String                  @id @default(cuid())
  name      String                  @unique // e.g., "ATFL", "Calcaneofibular Ligament", "Deltoid Ligament"
  joint     String?                 // e.g., ankle, knee, foot
  exercises ExerciseLigamentGroup[]
  createdAt DateTime                @default(now())
}

// Explicit join table (Exercise <-> MuscleGroup). Explicit tables port cleanly
// to Azure SQL Server and leave room for future per-tag metadata.
model ExerciseMuscleGroup {
  exerciseId    String
  exercise      Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscleGroupId String
  muscleGroup   MuscleGroup @relation(fields: [muscleGroupId], references: [id], onDelete: Cascade)

  @@id([exerciseId, muscleGroupId])
}

// Explicit join table (Exercise <-> LigamentGroup).
model ExerciseLigamentGroup {
  exerciseId      String
  exercise        Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  ligamentGroupId String
  ligamentGroup   LigamentGroup @relation(fields: [ligamentGroupId], references: [id], onDelete: Cascade)

  @@id([exerciseId, ligamentGroupId])
}

model ExerciseVideo {
  id              String   @id @default(cuid())
  exerciseId      String
  exercise        Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  url             String
  title           String?
  source          String?  // youtube, vimeo, upload
  durationSeconds Int?
  createdAt       DateTime @default(now())
}

model Video {
  id        String           @id @default(cuid())
  sessionId String
  session   ScreeningSession @relation(fields: [sessionId], references: [id])
  viewType  String           // "front" or "side"
  filename  String
  mimeType  String
  size      Int
  createdAt DateTime         @default(now())
}

model CoachClub {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubId  String
  club    Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, clubId])
}

model ParentAthlete {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  athleteId String
  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, athleteId])
}
